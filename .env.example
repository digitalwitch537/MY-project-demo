# Docker Hub
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest

# Production
APP_PORT=80
MONGO_ROOT_USERNAME=mernadmin
MONGO_ROOT_PASSWORD=use-a-long-url-safe-password

# Staging used by the DAST stage
STAGING_PORT=8080

# SonarQube database, generated by infra/ec2/bootstrap.sh
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=generated-on-the-ec2-host
